# ==============================================================================
# 211 Marketing — Environment Variables Template
# Copy this file to .env or configure in Cloudflare Pages / Vercel Environment
# ==============================================================================

# Public Site URL (Used for Canonical URLs, Open Graph, Sitemap and JSON-LD)
# Example: https://211marketing.in
SITE_URL="https://211marketing.in"

# Business Email (Where free-check form submissions are delivered)
# Example: contact@211marketing.in
BUSINESS_EMAIL="contact@211marketing.in"

# Resend API Key (Transactional email provider)
# Obtain from https://resend.com/api-keys
# In local development without this key, submissions are logged to server console
RESEND_API_KEY=""

# Cloudflare Turnstile Keys (Bot protection)
# Obtain from Cloudflare Dashboard > Turnstile
# In local development without these keys, Turnstile verification passes mock check
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Feature Flags
# Controls whether the pricing row appears in FAQ on Home/Healthcare and in schema.org
SHOW_PRICING_FAQ="true"

# Controls whether Google Analytics 4 is enabled after user consent
ANALYTICS_ENABLED="false"
PUBLIC_GA_MEASUREMENT_ID=""
