---
import { SITE_CONFIG } from "../config/site";

export interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

// Google Maps embed query for B-1405, The Capital, Science City Road, Sola, Ahmedabad 380060
const mapEmbedUrl = "https://www.google.com/maps?q=The+Capital+Science+City+Road+Sola+Ahmedabad+Gujarat+380060&output=embed";
const googleMapsDirectionsUrl = "https://www.google.com/maps/search/?api=1&query=The+Capital+Science+City+Road+Sola+Ahmedabad+380060";
---

<div class={`rounded-lg overflow-hidden border border-stone-soft bg-canvas-muted ${className}`}>
  <div class="p-4 bg-navy text-canvas-warm flex items-center justify-between text-xs sm:text-sm">
    <div class="flex items-center space-x-2">
      <svg class="w-4 h-4 text-taupe-light flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      <span class="font-medium truncate">{SITE_CONFIG.address.streetAddress}</span>
    </div>
    <a
      href={googleMapsDirectionsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-taupe-light hover:text-canvas-warm underline underline-offset-2 flex-shrink-0"
    >
      Open in Google Maps &rarr;
    </a>
  </div>

  <div class="relative w-full h-80 sm:h-96">
    <iframe
      src={mapEmbedUrl}
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      sandbox="allow-scripts allow-same-origin allow-popups"
      title="211 Marketing Office Location Map — The Capital, Science City Road, Sola, Ahmedabad"
      class="w-full h-full"
    ></iframe>
  </div>
</div>
