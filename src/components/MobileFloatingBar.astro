---
import { SITE_CONFIG } from "../config/site";
---

<!-- Sticky Mobile Call & WhatsApp Bar (Visible only on screens < md) -->
<aside class="fixed bottom-0 left-0 right-0 z-30 md:hidden bg-navy-deep border-t border-navy-light p-3 shadow-lg" aria-label="Quick contact shortcuts">
  <div class="grid grid-cols-2 gap-2 max-w-sm mx-auto">
    
    <!-- Click to Call -->
    <a
      href={SITE_CONFIG.contact.phoneHref}
      class="flex items-center justify-center space-x-2 bg-navy text-canvas-warm border border-stone-soft/30 font-medium py-2.5 px-3 rounded text-xs active:bg-navy-light transition-colors"
      aria-label="Call 211 Marketing now"
    >
      <svg class="w-4 h-4 text-taupe-light" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
      </svg>
      <span>Call Agency</span>
    </a>

    <!-- WhatsApp -->
    <a
      href={SITE_CONFIG.contact.whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center space-x-2 bg-[#25D366] text-white font-medium py-2.5 px-3 rounded text-xs active:bg-[#1EBE5D] transition-colors shadow-sm"
      aria-label="Chat with 211 Marketing on WhatsApp"
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12.031 2C6.516 2 2.031 6.484 2.031 12c0 1.95.556 3.784 1.527 5.344L2 22l4.805-1.523A9.972 9.972 0 0012.03 22c5.516 0 10-4.484 10-10 0-5.516-4.484-10-9.999-10zm0 18.25c-1.633 0-3.15-.477-4.43-1.297l-.316-.2-2.86.906.918-2.785-.207-.332A8.196 8.196 0 013.805 12c0-4.547 3.687-8.234 8.226-8.234 4.54 0 8.227 3.687 8.227 8.234 0 4.547-3.688 8.25-8.227 8.25zm4.512-6.188c-.246-.125-1.465-.723-1.691-.805-.227-.082-.39-.125-.555.125-.164.246-.637.805-.781.97-.145.164-.289.184-.535.062-.246-.125-1.04-.383-1.98-1.223-.73-.652-1.223-1.457-1.367-1.703-.145-.246-.016-.38.105-.504.11-.11.246-.289.37-.434.125-.145.164-.246.246-.41.082-.164.041-.309-.02-.434-.062-.125-.555-1.336-.762-1.832-.203-.484-.41-.418-.555-.426-.145-.008-.309-.008-.473-.008-.164 0-.434.062-.66.309-.227.246-.867.848-.867 2.066s.887 2.395 1.012 2.563c.125.164 1.746 2.664 4.23 3.738.59.254 1.05.406 1.41.52.594.191 1.137.164 1.566.1.477-.07 1.465-.6 1.672-1.18.207-.578.207-1.074.145-1.18-.062-.105-.227-.164-.473-.289z"/>
      </svg>
      <span>WhatsApp</span>
    </a>

  </div>
</aside>
