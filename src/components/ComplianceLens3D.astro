---
// Interactive 3D Compliance Gyroscope & Diagnostic Lens
// Represents the 8-Point NMC 2026 Review Framework
// Clinical, mechanical precision with brushed metals and stone rings.
---

<div class="relative w-full max-w-sm mx-auto aspect-square rounded-2xl overflow-hidden bg-navy-deep border border-stone-soft/30 shadow-md group">
  <canvas id="compliance-lens-canvas" class="w-full h-full cursor-grab active:cursor-grabbing block"></canvas>

  <!-- Interactive Status Overlay -->
  <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-[11px] font-mono text-taupe-light/90 bg-navy/90 backdrop-blur-xs px-3 py-1.5 rounded border border-stone-soft/30 pointer-events-none select-none">
    <span class="flex items-center space-x-1.5">
      <span class="w-2 h-2 rounded-full bg-[#25D366]"></span>
      <span>NMC 8-POINT LENS</span>
    </span>
    <span>3D CLINICAL BALANCE</span>
  </div>
</div>

<script>
  import * as THREE from 'three';

  function initComplianceLens() {
    const canvas = document.getElementById('compliance-lens-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const container = canvas.parentElement;
    if (!container) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Scene & Camera
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(42, container.clientWidth / container.clientHeight, 0.1, 100);
    camera.position.set(0, 0, 7.5);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance'
    });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Lighting
    const ambient = new THREE.AmbientLight(0xF6F2EA, 0.8);
    scene.add(ambient);

    const dirLight1 = new THREE.DirectionalLight(0xFFF5E8, 2.0);
    dirLight1.position.set(4, 6, 6);
    scene.add(dirLight1);

    const dirLight2 = new THREE.DirectionalLight(0x7A93A6, 1.2);
    dirLight2.position.set(-5, -4, -3);
    scene.add(dirLight2);

    // Root Gimbal Group
    const root = new THREE.Group();
    scene.add(root);

    // Materials
    const brassMat = new THREE.MeshStandardMaterial({
      color: 0x9A8A72,
      roughness: 0.32,
      metalness: 0.6
    });

    const navyMetalMat = new THREE.MeshStandardMaterial({
      color: 0x324A5C,
      roughness: 0.45,
      metalness: 0.35
    });

    const stoneMat = new THREE.MeshStandardMaterial({
      color: 0xD8D1C6,
      roughness: 0.5,
      metalness: 0.2
    });

    // Outer Ring (Toroid)
    const outerRingGeo = new THREE.TorusGeometry(2.4, 0.08, 16, 64);
    const outerRing = new THREE.Mesh(outerRingGeo, navyMetalMat);
    root.add(outerRing);

    // 8 Precision Checkpoint Nodes on Outer Ring (Representing the 8-point NMC review)
    const nodeGeo = new THREE.CylinderGeometry(0.12, 0.12, 0.24, 16);
    for (let i = 0; i < 8; i++) {
      const angle = (i / 8) * Math.PI * 2;
      const node = new THREE.Mesh(nodeGeo, stoneMat);
      node.position.set(Math.cos(angle) * 2.4, Math.sin(angle) * 2.4, 0);
      node.rotation.z = angle + Math.PI / 2;
      outerRing.add(node);
    }

    // Middle Gimbal Ring
    const midRingGeo = new THREE.TorusGeometry(1.85, 0.06, 16, 50);
    const midRing = new THREE.Mesh(midRingGeo, brassMat);
    root.add(midRing);

    // Inner Lens Ring
    const innerRingGeo = new THREE.TorusGeometry(1.25, 0.05, 16, 40);
    const innerRing = new THREE.Mesh(innerRingGeo, stoneMat);
    root.add(innerRing);

    // Central Precision Reticle / Crosshairs
    const crossGeo = new THREE.BoxGeometry(1.9, 0.02, 0.02);
    const cross1 = new THREE.Mesh(crossGeo, brassMat);
    const cross2 = new THREE.Mesh(crossGeo, brassMat);
    cross2.rotation.z = Math.PI / 2;
    innerRing.add(cross1);
    innerRing.add(cross2);

    // Central Core Jewel (Restrained Matte Ivory)
    const coreGeo = new THREE.OctahedronGeometry(0.35, 1);
    const coreMesh = new THREE.Mesh(coreGeo, stoneMat);
    root.add(coreMesh);

    // Interactive Drag & Parallax
    let isDragging = false;
    let prevPointer = { x: 0, y: 0 };
    let targetRot = { x: 0.3, y: 0.4 };
    let rotVel = { x: 0, y: 0 };

    canvas.addEventListener('pointerdown', (e) => {
      isDragging = true;
      prevPointer = { x: e.clientX, y: e.clientY };
      canvas.setPointerCapture(e.pointerId);
    });

    canvas.addEventListener('pointermove', (e) => {
      if (isDragging) {
        const dx = e.clientX - prevPointer.x;
        const dy = e.clientY - prevPointer.y;
        prevPointer = { x: e.clientX, y: e.clientY };
        targetRot.y += dx * 0.01;
        targetRot.x += dy * 0.01;
        rotVel = { x: dy * 0.005, y: dx * 0.005 };
      }
    });

    const endDrag = () => { isDragging = false; };
    canvas.addEventListener('pointerup', endDrag);
    canvas.addEventListener('pointercancel', endDrag);

    // Pointer Parallax
    container.addEventListener('mousemove', (e) => {
      if (isDragging) return;
      const rect = container.getBoundingClientRect();
      const normX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      const normY = -(((e.clientY - rect.top) / rect.height) * 2 - 1);
      targetRot.y = normX * 0.6;
      targetRot.x = -normY * 0.5;
    });

    // Resize
    window.addEventListener('resize', () => {
      if (!container) return;
      const w = container.clientWidth;
      const h = container.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    });

    // Render Loop
    let clock = new THREE.Clock();
    let isVisible = true;
    const observer = new IntersectionObserver(([entry]) => {
      isVisible = entry.isIntersecting;
    }, { threshold: 0.1 });
    observer.observe(container);

    function loop() {
      requestAnimationFrame(loop);
      if (!isVisible) return;

      const delta = clock.getDelta();
      const elapsed = clock.getElapsedTime();

      if (!prefersReducedMotion) {
        if (!isDragging) {
          targetRot.y += delta * 0.15;
          rotVel.x *= 0.94;
          rotVel.y *= 0.94;
          targetRot.x += rotVel.x;
          targetRot.y += rotVel.y;
        }

        root.rotation.x += (targetRot.x - root.rotation.x) * 0.08;
        root.rotation.y += (targetRot.y - root.rotation.y) * 0.08;

        // Differential ring counter-rotations
        midRing.rotation.x = Math.sin(elapsed * 0.8) * 0.45;
        midRing.rotation.y = elapsed * 0.35;

        innerRing.rotation.y = -elapsed * 0.5;
        innerRing.rotation.z = Math.cos(elapsed * 0.7) * 0.3;

        coreMesh.rotation.x = elapsed * 0.8;
        coreMesh.rotation.y = elapsed * 1.1;
      }

      renderer.render(scene, camera);
    }

    loop();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initComplianceLens);
  } else {
    initComplianceLens();
  }
</script>
