---
// Interactive 3D Kinetic Sculpture representing "211"
// "2 is the sweep of creative thinking; 11 is the structure of disciplined execution."
// Materiality: Architectural stone, matte brass, deep slate. Zero AI-clichés.
---

<div class="relative w-full max-w-md mx-auto aspect-square rounded-2xl overflow-hidden bg-canvas-muted/80 border border-stone-soft shadow-inner group">
  <!-- Interactive Canvas -->
  <canvas id="sculpture-3d-canvas" class="w-full h-full cursor-grab active:cursor-grabbing block"></canvas>

  <!-- Tactile Control Cue -->
  <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-[11px] font-mono text-taupe-quiet/80 bg-canvas/90 backdrop-blur-xs px-3 py-1.5 rounded border border-stone-soft/60 pointer-events-none select-none">
    <span>KINETIC EMBLEM: 2 + 11</span>
    <span class="flex items-center space-x-1">
      <svg class="w-3 h-3 text-taupe-quiet animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"/>
      </svg>
      <span>DRAG TO ROTATE</span>
    </span>
  </div>
</div>

<script>
  import * as THREE from 'three';

  function initSculpture() {
    const canvas = document.getElementById('sculpture-3d-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const container = canvas.parentElement;
    if (!container) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. Scene, Camera & Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(40, container.clientWidth / container.clientHeight, 0.1, 100);
    camera.position.set(0, 1.2, 9);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance'
    });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.1;

    // 2. Studio Lighting Setup (Calm, Warm Gallery Lighting)
    const ambientLight = new THREE.AmbientLight(0xF6F2EA, 0.9);
    scene.add(ambientLight);

    const keyLight = new THREE.DirectionalLight(0xFFF8E7, 1.8);
    keyLight.position.set(6, 8, 8);
    scene.add(keyLight);

    const fillLight = new THREE.DirectionalLight(0xDCE4EC, 0.8);
    fillLight.position.set(-6, -2, -4);
    scene.add(fillLight);

    const rimLight = new THREE.DirectionalLight(0x9A8A72, 1.2);
    rimLight.position.set(0, -6, 5);
    scene.add(rimLight);

    // Root Group
    const group = new THREE.Group();
    scene.add(group);

    // 3. Materials (Tactile Architectural Finishes)
    // "2" Sweep Material: Brushed muted champagne brass
    const brassMaterial = new THREE.MeshStandardMaterial({
      color: 0x9A8A72,
      roughness: 0.38,
      metalness: 0.45
    });

    // "11" Pillars Material: Deep architectural ink slate
    const slateMaterial = new THREE.MeshStandardMaterial({
      color: 0x263947,
      roughness: 0.55,
      metalness: 0.15
    });

    // Accent Material: Warm ivory stone
    const stoneMaterial = new THREE.MeshStandardMaterial({
      color: 0xD8D1C6,
      roughness: 0.65,
      metalness: 0.05
    });

    // 4. Constructing "2" (The Organic Sweep of Creative Thinking)
    // Continuous 3D curve with elegant sweep
    const curvePoints: THREE.Vector3[] = [];
    // Arch loop of 2
    for (let t = 0; t <= Math.PI * 1.35; t += 0.08) {
      const r = 1.35;
      const x = -1.3 + Math.cos(t) * r * 0.9;
      const y = 0.9 + Math.sin(t) * r * 1.05;
      const z = Math.sin(t * 1.5) * 0.45;
      curvePoints.push(new THREE.Vector3(x, y, z));
    }
    // Diagonal descent of 2
    for (let t = 0; t <= 1.0; t += 0.08) {
      const x = -1.3 - (1 - t) * 1.1 + t * 0.3;
      const y = 0.4 - t * 1.7;
      const z = (1 - t) * 0.3 - t * 0.2;
      curvePoints.push(new THREE.Vector3(x, y, z));
    }
    // Horizontal baseline of 2
    for (let t = 0; t <= 1.0; t += 0.08) {
      const x = -1.0 + t * 1.7;
      const y = -1.3;
      const z = -0.2 + t * 0.4;
      curvePoints.push(new THREE.Vector3(x, y, z));
    }

    const splineCurve = new THREE.CatmullRomCurve3(curvePoints);
    const sweepGeometry = new THREE.TubeGeometry(splineCurve, 70, 0.22, 16, false);
    const sweepMesh = new THREE.Mesh(sweepGeometry, brassMaterial);
    group.add(sweepMesh);

    // Decorative joint caps
    const capGeo = new THREE.SphereGeometry(0.24, 16, 16);
    const startCap = new THREE.Mesh(capGeo, stoneMaterial);
    startCap.position.copy(curvePoints[0]);
    group.add(startCap);

    const endCap = new THREE.Mesh(capGeo, stoneMaterial);
    endCap.position.copy(curvePoints[curvePoints.length - 1]);
    group.add(endCap);

    // 5. Constructing "11" (Twin Monolithic Architectural Pillars)
    const pillarWidth = 0.44;
    const pillarHeight = 3.6;
    const pillarDepth = 0.44;
    const pillarGeo = new THREE.BoxGeometry(pillarWidth, pillarHeight, pillarDepth);

    // Pillar 1
    const pillar1 = new THREE.Mesh(pillarGeo, slateMaterial);
    pillar1.position.set(1.4, 0.1, -0.2);
    group.add(pillar1);

    // Pillar 2
    const pillar2 = new THREE.Mesh(pillarGeo, slateMaterial);
    pillar2.position.set(2.2, 0.1, 0.2);
    group.add(pillar2);

    // Pillar crown accents (Soft Stone)
    const crownGeo = new THREE.BoxGeometry(pillarWidth + 0.08, 0.12, pillarDepth + 0.08);
    const crown1 = new THREE.Mesh(crownGeo, stoneMaterial);
    crown1.position.set(1.4, 1.95, -0.2);
    group.add(crown1);

    const crown2 = new THREE.Mesh(crownGeo, stoneMaterial);
    crown2.position.set(2.2, 1.95, 0.2);
    group.add(crown2);

    // Architectural pedestal base
    const baseGeo = new THREE.CylinderGeometry(3.6, 3.8, 0.18, 36);
    const baseMesh = new THREE.Mesh(baseGeo, stoneMaterial);
    baseMesh.position.set(0.4, -1.8, 0);
    group.add(baseMesh);

    // 6. Interactive Orbit & Inertia
    let isDragging = false;
    let prevPointer = { x: 0, y: 0 };
    let rotationVelocity = { x: 0, y: 0 };
    let targetRotation = { x: 0.15, y: -0.35 };

    canvas.addEventListener('pointerdown', (e) => {
      isDragging = true;
      prevPointer = { x: e.clientX, y: e.clientY };
      canvas.setPointerCapture(e.pointerId);
    });

    canvas.addEventListener('pointermove', (e) => {
      if (isDragging) {
        const deltaX = e.clientX - prevPointer.x;
        const deltaY = e.clientY - prevPointer.y;
        prevPointer = { x: e.clientX, y: e.clientY };

        targetRotation.y += deltaX * 0.008;
        targetRotation.x += deltaY * 0.008;
        rotationVelocity = { x: deltaY * 0.004, y: deltaX * 0.004 };
      }
    });

    function endDrag() {
      isDragging = false;
    }
    canvas.addEventListener('pointerup', endDrag);
    canvas.addEventListener('pointercancel', endDrag);

    // Subtle pointer parallax when hovering
    container.addEventListener('mousemove', (e) => {
      if (isDragging) return;
      const rect = container.getBoundingClientRect();
      const normX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      const normY = -(((e.clientY - rect.top) / rect.height) * 2 - 1);
      targetRotation.y = -0.35 + normX * 0.45;
      targetRotation.x = 0.15 - normY * 0.3;
    });

    // Resize
    function handleResize() {
      if (!container) return;
      const w = container.clientWidth;
      const h = container.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    }
    window.addEventListener('resize', handleResize);

    // 7. Render Loop with Visibility Check
    let isVisible = true;
    const observer = new IntersectionObserver(([entry]) => {
      isVisible = entry.isIntersecting;
    }, { threshold: 0.1 });
    observer.observe(container);

    let clock = new THREE.Clock();

    function renderLoop() {
      requestAnimationFrame(renderLoop);
      if (!isVisible) return;

      const delta = clock.getDelta();

      if (!prefersReducedMotion) {
        if (!isDragging) {
          // Slow floating idle rotation
          targetRotation.y += delta * 0.18;
          rotationVelocity.x *= 0.94;
          rotationVelocity.y *= 0.94;
          targetRotation.x += rotationVelocity.x;
          targetRotation.y += rotationVelocity.y;
        }

        // Clamp vertical tilt
        targetRotation.x = Math.max(-0.6, Math.min(0.6, targetRotation.x));

        // Smooth spring interpolation
        group.rotation.x += (targetRotation.x - group.rotation.x) * 0.07;
        group.rotation.y += (targetRotation.y - group.rotation.y) * 0.07;

        // Subtle floating bob
        const time = clock.getElapsedTime();
        group.position.y = Math.sin(time * 1.2) * 0.08;
      }

      renderer.render(scene, camera);
    }

    renderLoop();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSculpture);
  } else {
    initSculpture();
  }
</script>
