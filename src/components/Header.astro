---
import { SITE_CONFIG } from "../config/site";

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/healthcare-marketing/", label: "Healthcare" },
  { href: "/services/", label: "Services" },
  { href: "/nmc-guidelines-2026/", label: "NMC Guide" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" }
];
---

<header class="bg-navy text-canvas-warm sticky top-0 z-40 border-b border-navy-light shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo / Wordmark -->
      <a href="/" class="flex items-center space-x-3 group focus:outline-none focus:ring-2 focus:ring-canvas-warm rounded py-1 px-2" aria-label="211 Marketing Home">
        <div class="flex items-center">
          <span class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight text-canvas-warm">2</span>
          <span class="inline-flex space-x-1 ml-1">
            <span class="w-1.5 h-6 bg-stone-soft rounded-sm inline-block"></span>
            <span class="w-1.5 h-6 bg-stone-soft rounded-sm inline-block"></span>
          </span>
        </div>
        <div class="h-8 w-px bg-navy-light hidden sm:block"></div>
        <div class="flex flex-col">
          <span class="font-sans text-sm sm:text-base font-bold tracking-widest text-canvas-warm leading-tight">MARKETING</span>
          <span class="font-sans text-[10px] tracking-wider text-taupe-light uppercase">Healthcare · Ahmedabad</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2" aria-label="Main Navigation">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <a
              href={link.href}
              class={`px-3 py-2 text-sm font-medium rounded-md transition-colors ${
                isActive
                  ? "text-canvas-warm bg-navy-light font-semibold border-b-2 border-taupe-quiet"
                  : "text-canvas-warm/85 hover:text-canvas-warm hover:bg-navy-light/60"
              }`}
              aria-current={isActive ? "page" : undefined}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Desktop CTA & Phone -->
      <div class="hidden lg:flex items-center space-x-4">
        <a
          href={SITE_CONFIG.contact.phoneHref}
          class="text-xs text-canvas-warm/80 hover:text-canvas-warm flex items-center space-x-1 py-1 px-2"
          aria-label="Call 211 Marketing"
        >
          <svg class="w-3.5 h-3.5 text-taupe-light" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span class="tracking-wide">{SITE_CONFIG.contact.telephone}</span>
        </a>
        <a
          href="/free-nmc-check/"
          class="bg-canvas-warm text-navy font-semibold px-4 py-2 text-sm rounded transition-all hover:bg-white hover:shadow-md focus:ring-2 focus:ring-offset-2 focus:ring-canvas-warm"
        >
          Free NMC Check
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center space-x-2 md:hidden">
        <a
          href="/free-nmc-check/"
          class="bg-canvas-warm text-navy text-xs font-semibold px-2.5 py-1.5 rounded"
        >
          Free Check
        </a>
        <button
          type="button"
          id="mobile-menu-toggle"
          class="p-2 rounded-md text-canvas-warm hover:bg-navy-light focus:outline-none focus:ring-2 focus:ring-canvas-warm"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Open primary menu"
        >
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-navy-deep border-t border-navy-light px-4 pt-3 pb-6 space-y-2">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href;
      return (
        <a
          href={link.href}
          class={`block px-3 py-2.5 rounded-md text-base font-medium ${
            isActive
              ? "bg-navy text-canvas-warm font-semibold border-l-4 border-taupe-quiet"
              : "text-canvas-warm/90 hover:bg-navy hover:text-canvas-warm"
          }`}
          aria-current={isActive ? "page" : undefined}
        >
          {link.label}
        </a>
      );
    })}
    <div class="pt-4 border-t border-navy-light space-y-2">
      <a
        href="/free-nmc-check/"
        class="block w-full text-center bg-canvas-warm text-navy font-semibold py-2.5 px-4 rounded"
      >
        Get a free NMC-aware check
      </a>
      <a
        href={SITE_CONFIG.contact.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="block w-full text-center border border-stone-soft/40 text-canvas-warm py-2 px-4 rounded text-sm hover:bg-navy-light"
      >
        WhatsApp us ({SITE_CONFIG.contact.whatsapp})
      </a>
    </div>
  </div>
</header>

<script>
  // Clean, minimal accessible mobile menu script
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const hamburgerIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");

  if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener("click", () => {
      const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
      toggleBtn.setAttribute("aria-expanded", (!isExpanded).toString());
      mobileMenu.classList.toggle("hidden");
      hamburgerIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }
</script>
